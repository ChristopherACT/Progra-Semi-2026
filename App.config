<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!--
      Ajuste "Server" segun su instancia de SQL Server:
        .\SQLEXPRESS          -> SQL Server Express (lo mas comun)
        (localdb)\MSSQLLocalDB -> LocalDB que trae Visual Studio
        .                     -> instancia por defecto
      La base de datos y la tabla se crean automaticamente al abrir la aplicacion.
    -->
    <add name="cnx"
         connectionString="Server=.\SQLEXPRESS;Database=db_proyecto_USSS004525;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
